# .env.backtest.example — config minimal per PC secondario (backtest-only)
# ──────────────────────────────────────────────
# Scopo: eseguire scripts/run_baseline_05_09.py senza MT5 live, senza Claude API.
# Sul PC secondario: `cp .env.backtest.example .env`.
#
# Tutti i valori riflettono il `.env` del PC primario alla data 2026-05-12
# (commit corrente, run Plan 05-09 STEP 3 che ha prodotto 1076 rows).
# Modificare un solo parametro INVALIDA la riproducibilità fra i due PC —
# il backtest darà output diverso.
#
# Non includere:
#   - MT5_*       (non serve, backtest legge CSV in data/historical/)
#   - CLAUDE_*    (non serve, backtest non chiama LLM)
#   - INTRADAY_*, OPERATING_*, SESSION_*, NEWS_*, SENTIMENT_*, SCHEDULER_*
#     (consumati solo da live trader; backtest engine forza
#      _always_open_cfg() in engine.py:51-59)
#   - STRATEGY_CONFIG_PATH (lasciare UNSET; il default carica
#     config/strategy.yaml dal repo, che è quello commitato e firmato sha256).
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# Risk — sizing e SL bounds (consumati da risk_engine.evaluate_trade)
# ──────────────────────────────────────────────
# MAX_DAILY_DRAWDOWN_PERCENT=20.0 — valore canonical condiviso live + backtest.
# Razionale: account di partenza ~€100 con RISK_PER_TRADE_PERCENT=2% (=€2/trade);
# il kill-switch giornaliero deve permettere ~5-10 trade perdenti prima di
# fermare la giornata, quindi 10-20% e' il range realistico. 20% e' il cap
# operativo dichiarato dall'utente ("usero massimo il 20%"). Vale ANCHE in
# produzione — non esistono piu' ambienti a 2% nel progetto.
# Phase 7 ML training si basa su questo valore: cambiare a posteriori invaliderebbe
# il dataset baseline (rejection rate kill-switch e' una feature implicita).
RISK_MODE=AGGRESSIVE
RISK_AMOUNT_MODE=PERCENT
RISK_PER_TRADE_PERCENT=0.5
RISK_PER_TRADE_AMOUNT=100.0
MAX_LOTS_PER_TRADE=1.0
MIN_SL_PIPS=8
MAX_SL_PIPS=80
MAX_DAILY_DRAWDOWN_PERCENT=20.0
MIN_PROTECT_PROFIT_R_MULTIPLIER=1.0

# ──────────────────────────────────────────────
# Filtri tecnici strategia (consumati dallo strategy via _shim.py)
# ──────────────────────────────────────────────
MIN_ATR_PIPS=3
MAX_ATR_PIPS=50
MIN_TREND_STRENGTH=0.65
MIN_BREAKOUT_VOLUME_RATIO=1.3
MIN_RISK_REWARD_RATIO=1.5
MAX_RSI_OVERBOUGHT=75
MIN_RSI_OVERSOLD=25
MIN_CONFIDENCE_TO_PROPOSE=0.60

# ──────────────────────────────────────────────
# Logging (innocuo, default ok)
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ──────────────────────────────────────────────
# Execution mode — shadow obbligatorio (irrelevant in backtest, ma config.py lo legge a import-time)
# ──────────────────────────────────────────────
EXECUTION_MODE=shadow
