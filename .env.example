# ──────────────────────────────────────────────
# MT5 — credenziali conto demo (broker: TenTrade)
# ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=TenTrade-Demo

# ──────────────────────────────────────────────
# Risk — parametri conservativi di default
# ──────────────────────────────────────────────
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_DRAWDOWN_PERCENT=2.0
MIN_SL_PIPS=8
MAX_SL_PIPS=80
RISK_MODE=CONSERVATIVE
# RISK_AMOUNT_MODE: PERCENT (usa RISK_PER_TRADE_PERCENT) oppure FIXED_AMOUNT (usa RISK_PER_TRADE_AMOUNT)
RISK_AMOUNT_MODE=PERCENT
RISK_PER_TRADE_AMOUNT=100.0
# MAX_LOTS_PER_TRADE: 0 = usa il default del profilo (CONSERVATIVE=0.3, MODERATE=0.5, AGGRESSIVE=1.0)
MAX_LOTS_PER_TRADE=0

# ──────────────────────────────────────────────
# Symbols / Sessione
# ──────────────────────────────────────────────
SYMBOLS=EURUSD
SESSION_START=08:00
SESSION_END=20:00
USE_SESSION_FILTER=true

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ──────────────────────────────────────────────
# Claude API
# ──────────────────────────────────────────────
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.5

# ──────────────────────────────────────────────
# Analisi
# ──────────────────────────────────────────────
TIMEFRAME=M15

# ──────────────────────────────────────────────
# Execution — NON cambiare a live prima di Fase 10 validata 
#  shadow = esecuzione reale ma senza inviare ordini a MT5,
#  paper= esecuzione reale inviando ordini a MT5 DEMO,
#  live = esecuzione reale con invio ordini a MT5 REALE
# ──────────────────────────────────────────────
EXECUTION_MODE=shadow

# ──────────────────────────────────────────────
# Scheduler / Daily orchestrator (fase 13)
# ──────────────────────────────────────────────
OPERATING_TIMEZONE=Europe/Rome
OPERATING_START_HOUR=7
OPERATING_END_HOUR=22
# MAIN_CYCLE_HOURS=4 -> gira a: 7, 11, 15, 19 (include 15!)
MAIN_CYCLE_HOURS=4
DAILY_TARGET_DECISIONS=5
# clamp: max 120 minutes
MAX_DELAY_MINUTES=120
MAX_SYMBOLS_TO_DEEPEN=3
FOLLOWUP_ENABLED=true
SCHEDULER_POLL_SECONDS=5
# Cadenza ciclo intraday (default 5 min)
INTRADAY_CYCLE_MINUTES=5

# ──────────────────────────────────────────────
# Scheduler H24 (fase 16)
# ──────────────────────────────────────────────
# Intervallo tra cicli del loop interno (default 15 min)
INTRADAY_SCAN_INTERVAL_MINUTES=15
# Ritardo del primo ciclo dopo l'avvio (default 5 min)
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=5
# Pausa trading: se true blocca apertura nuovi trade ma mantiene heart-beat e scan light
PAUSE_TRADING=false
# Modalità dry-run: nessun ordine reale (send_order/close_position) viene inviato a MT5
DRY_RUN=false
# Soglia di profitto (multiplo di R = entry-SL) oltre la quale chiudere posizione se contesto tecnico negativo
MIN_PROTECT_PROFIT_R_MULTIPLIER=1.0
# Finestra rolling per controllo drawdown aggiuntivo (oltre il giornaliero del risk_engine)
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=3.0
# Rotazione log: daily | weekly | size
LOG_ROTATION=weekly
WEEKLY_LOG_BACKUP_COUNT=8
# Se true chiude tutte le posizioni intraday a fine finestra giornaliera (no overnight)
CLOSE_BEFORE_END_OF_WINDOW=true

# ──────────────────────────────────────────────
# Strategia Intraday (fase 14)
# ──────────────────────────────────────────────
STRATEGY_MODE=intraday
INTRADAY_SYMBOLS=EURUSD,GBPUSD,USDJPY
# Timeframe ammessi: M1, M5, M10, M15, M30
INTRADAY_TIMEFRAME=M15
INTRADAY_LOOKBACK_BARS=200
INTRADAY_SCAN_TOP_N=3
INTRADAY_START_HOUR=8
INTRADAY_END_HOUR=20
AVOID_MAJOR_NEWS_TIMES=true

# Parametri tecnici
MIN_ATR_PIPS=3
MAX_ATR_PIPS=50
MIN_TREND_STRENGTH=0.65
MIN_BREAKOUT_VOLUME_RATIO=1.3
MIN_RISK_REWARD_RATIO=1.5
MAX_RSI_OVERBOUGHT=75
MIN_RSI_OVERSOLD=25
MIN_CONFIDENCE_TO_PROPOSE=0.60

# RSI_SMA strategy (verified: 60.3% WR on 2024)
# Enable RSI_SMA strategy (checked first, before default strategy)
RSI_SMA_ENABLED=true
RSI_SMA_MIN_RSI=65
RSI_SMA_MAX_RSI=80
RSI_SMA_SMA_PERIOD=200
RSI_SMA_HOUR=15  # Scheduler runs at 15:00 (7, 11, 15, 19)
RSI_SMA_HOLD_BARS=2

# Pattern recognition
ENABLE_CANDLESTICK_PATTERNS=true
PATTERN_CONFIRMATION_BARS=2

# Support / Resistance
SR_LOOKBACK_BARS=100
SR_TOLERANCE_PIPS=5

# ──────────────────────────────────────────────
# RSS News Sentiment (fase 15) — opzionale
# ──────────────────────────────────────────────
ENABLE_NEWS_SENTIMENT=false
NEWS_FETCH_INTERVAL_MINUTES=15
NEWS_LOOKBACK_HOURS=2
NEWS_CACHE_MAX_HOURS=24
SENTIMENT_MIN_STRENGTH_FILTER=0.6
SENTIMENT_BOOST_FACTOR=0.15
# SENTIMENT_CONFLICT_ACTION: skip | delay | reduce_confidence
SENTIMENT_CONFLICT_ACTION=delay
SENTIMENT_CONFLICT_DELAY_MINUTES=60
RSS_FEEDS=https://www.investing.com/rss/news_25.rss,https://www.forexlive.com/feed/news

# ──────────────────────────────────────────────
# HistData Download (script)
# ──────────────────────────────────────────────
# Simboli da scaricare (separati da virgola)
HISTDATA_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,EURGBP,EURJPY
# Anni da scaricare
HISTDATA_START_YEAR=2016
HISTDATA_END_YEAR=2026
# Delay tra richieste (secondi) per evitare ban
HISTDATA_REQUEST_DELAY=3
# Formato dati: ascii, metatrader, excel, ninjatrader, metastock
HISTDATA_FORMAT=ascii
# Timeframe: m1, tick-data
HISTDATA_TIMEFRAME=m1
# Directory dove salvare i dati
HISTDATA_DATA_DIR=data/histdata
# Verifica SSL (false = bypassa certificato scaduto, utile per HistData)
HISTDATA_VERIFY_SSL=false
