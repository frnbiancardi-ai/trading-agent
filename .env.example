# ──────────────────────────────────────────────
# MT5 — credenziali conto demo FP Markets
# ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=FPMarkets-Demo

# ──────────────────────────────────────────────
# Risk — parametri conservativi di default
# ──────────────────────────────────────────────
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_DRAWDOWN_PERCENT=2.0
MIN_SL_PIPS=8
MAX_SL_PIPS=80
RISK_MODE=CONSERVATIVE
# RISK_AMOUNT_MODE: PERCENT (usa RISK_PER_TRADE_PERCENT) oppure FIXED_AMOUNT (usa RISK_PER_TRADE_AMOUNT)
RISK_AMOUNT_MODE=PERCENT
RISK_PER_TRADE_AMOUNT=100.0
# MAX_LOTS_PER_TRADE: 0 = usa il default del profilo (CONSERVATIVE=0.3, MODERATE=0.5, AGGRESSIVE=1.0)
MAX_LOTS_PER_TRADE=0

# ──────────────────────────────────────────────
# Symbols / Sessione
# ──────────────────────────────────────────────
SYMBOLS=EURUSD
SESSION_START=08:00
SESSION_END=20:00
USE_SESSION_FILTER=true

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ──────────────────────────────────────────────
# Claude API
# ──────────────────────────────────────────────
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────
# Execution — NON cambiare a live prima di Fase 10 validata
# ──────────────────────────────────────────────
EXECUTION_MODE=shadow
