# ──────────────────────────────────────────────
# Profilo: CONSERVATIVE
# Obiettivo: capitale prima di tutto. Solo setup A-grade.
# R:R minimo alto, confidence minima alta, drawdown stretto.
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# MT5 — credenziali conto demo (broker: TenTrade)
# ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=TenTrade-Demo

# ──────────────────────────────────────────────
# Risk — profilo CONSERVATIVE
# ──────────────────────────────────────────────
RISK_MODE=CONSERVATIVE
RISK_PER_TRADE_PERCENT=0.5
MAX_DAILY_DRAWDOWN_PERCENT=1.5
MIN_SL_PIPS=8
MAX_SL_PIPS=50
RISK_AMOUNT_MODE=PERCENT
RISK_PER_TRADE_AMOUNT=50.0
# 0 = default profilo (CONSERVATIVE = 0.3 lots)
MAX_LOTS_PER_TRADE=0

# ──────────────────────────────────────────────
# Symbols / Sessione
# ──────────────────────────────────────────────
SYMBOLS=EURUSD
SESSION_START=09:00
SESSION_END=18:00
USE_SESSION_FILTER=true

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ──────────────────────────────────────────────
# Claude API
# ──────────────────────────────────────────────
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3

# ──────────────────────────────────────────────
# Analisi
# ──────────────────────────────────────────────
TIMEFRAME=M15

# ──────────────────────────────────────────────
# Execution — shadow obbligatorio finché non validato
# ──────────────────────────────────────────────
EXECUTION_MODE=shadow

# ──────────────────────────────────────────────
# Scheduler / Daily orchestrator
# ──────────────────────────────────────────────
OPERATING_TIMEZONE=Europe/Rome
OPERATING_START_HOUR=9
OPERATING_END_HOUR=18
OPERATING_WEEKDAYS=0,1,2,3,4
MAIN_CYCLE_HOURS=3
DAILY_TARGET_DECISIONS=3
MAX_DELAY_MINUTES=120
MAX_SYMBOLS_TO_DEEPEN=2
FOLLOWUP_ENABLED=true
SCHEDULER_POLL_SECONDS=5
INTRADAY_CYCLE_MINUTES=15

# ──────────────────────────────────────────────
# Scheduler H24
# ──────────────────────────────────────────────
INTRADAY_SCAN_INTERVAL_MINUTES=30
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=5
PAUSE_TRADING=false
DRY_RUN=false
MIN_PROTECT_PROFIT_R_MULTIPLIER=1.5
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=2.0
LOG_ROTATION=weekly
WEEKLY_LOG_BACKUP_COUNT=8
CLOSE_BEFORE_END_OF_WINDOW=true

# ──────────────────────────────────────────────
# Strategia Intraday
# ──────────────────────────────────────────────
STRATEGY_MODE=intraday
INTRADAY_SYMBOLS=EURUSD,GBPUSD
INTRADAY_TIMEFRAME=M15
INTRADAY_LOOKBACK_BARS=200
INTRADAY_SCAN_TOP_N=2
INTRADAY_START_HOUR=9
INTRADAY_END_HOUR=18
AVOID_MAJOR_NEWS_TIMES=true

# Parametri tecnici — soglie strette
MIN_ATR_PIPS=5
MAX_ATR_PIPS=40
MIN_TREND_STRENGTH=0.75
MIN_BREAKOUT_VOLUME_RATIO=1.5
MIN_RISK_REWARD_RATIO=2.5
MAX_RSI_OVERBOUGHT=70
MIN_RSI_OVERSOLD=30
MIN_CONFIDENCE_TO_PROPOSE=0.65

# Pattern recognition
ENABLE_CANDLESTICK_PATTERNS=true
PATTERN_CONFIRMATION_BARS=3

# Support / Resistance
SR_LOOKBACK_BARS=150
SR_TOLERANCE_PIPS=4

# ──────────────────────────────────────────────
# RSS News Sentiment — gating severo
# ──────────────────────────────────────────────
ENABLE_NEWS_SENTIMENT=true
NEWS_FETCH_INTERVAL_MINUTES=15
NEWS_LOOKBACK_HOURS=3
NEWS_CACHE_MAX_HOURS=24
SENTIMENT_MIN_STRENGTH_FILTER=0.7
SENTIMENT_BOOST_FACTOR=0.10
SENTIMENT_CONFLICT_ACTION=skip
SENTIMENT_CONFLICT_DELAY_MINUTES=90
RSS_FEEDS=https://www.investing.com/rss/news_25.rss,https://www.forexlive.com/feed/news
