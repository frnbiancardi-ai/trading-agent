# =============================================================================
# PROFILO CONSERVATIVO — Solo setup ad alta probabilita'
# =============================================================================
# Filosofia: pochi trade, alta qualita', drawdown minimo. Adatto a:
#   - Validazione iniziale
#   - Capitale reale piccolo (<5k USD)
#   - Volatilita' di mercato elevata (festivita', earnings season)
# Aspettative: 0-2 TRADE/giorno, prevalentemente NO_TRADE/WAIT_FOLLOW_UP
# =============================================================================


# -----------------------------------------------------------------------------
# MT5 BROKER (obbligatorio)
# -----------------------------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=TenTrade-Demo


# -----------------------------------------------------------------------------
# EXECUTION MODE — controlla se gli ordini arrivano davvero al broker
# -----------------------------------------------------------------------------
# shadow = simula tutto, NESSUN ordine inviato a MT5 (default sicuro)
# paper  = invia ordini su account demo
# live   = invia ordini su account reale (USARE SOLO DOPO VALIDAZIONE)
EXECUTION_MODE=shadow

# DRY_RUN=true salta anche la fase di simulazione, scrive solo log
DRY_RUN=false

# Pausa totale del trading (utile per manutenzione senza fermare il daemon)
PAUSE_TRADING=false


# -----------------------------------------------------------------------------
# UNIVERSE — quali simboli scansionare ogni ciclo
# -----------------------------------------------------------------------------
# Lista CSV. Solo coppie maggiori = spread basso, liquidita' alta.
# Evitare exotics (USDTRY, USDZAR) e cross minori in profilo conservativo.
INTRADAY_SYMBOLS=EURUSD,GBPUSD,USDJPY

# Top-N candidati su cui fare deep-analysis dopo light-scan.
# Conservativo: <= len(symbols), il daemon e' selettivo gia' a monte.
INTRADAY_SCAN_TOP_N=3

# Timeframe principale. M15 = compromesso noise/segnale per intraday.
# M5 troppo rumoroso, M30 troppo lento per 5 decisioni/giorno.
INTRADAY_TIMEFRAME=M15

# Numero barre storiche caricate per indicatori (ATR, RSI, SMA50 richiede >=50).
INTRADAY_LOOKBACK_BARS=200


# -----------------------------------------------------------------------------
# FINESTRA OPERATIVA — quando il daemon scansiona
# -----------------------------------------------------------------------------
OPERATING_TIMEZONE=Europe/Rome
# 0=lun, 1=mar, ... 4=ven (no weekend)
OPERATING_WEEKDAYS=0,1,2,3,4
# Sessione conservativa: solo overlap Londra/NY (massima liquidita')
INTRADAY_START_HOUR=9
INTRADAY_END_HOUR=18

# Frequenza scan. 15min = bassa pressione operativa, lascia formare segnali puliti
INTRADAY_SCAN_INTERVAL_MINUTES=15
# Ritardo primo ciclo dopo boot (evita scan su candele incomplete)
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=5

# Chiude posizioni intraday rimaste aperte a fine finestra (anti-overnight)
CLOSE_BEFORE_END_OF_WINDOW=true


# -----------------------------------------------------------------------------
# RISK ENGINE — dimensionamento posizione
# -----------------------------------------------------------------------------
# Profilo broker-side che limita max_lots e max_drawdown_pct
# CONSERVATIVE = max_lots 0.3, max_drawdown 1.5%
# MODERATE     = max_lots 0.5, max_drawdown 2.5%
# AGGRESSIVE   = max_lots 1.0, max_drawdown 4.0%
RISK_MODE=CONSERVATIVE

# Modalita' calcolo size:
# PERCENT = % del balance per trade
# AMOUNT  = importo fisso in valuta account
RISK_AMOUNT_MODE=PERCENT

# Rischio per trade in % del balance. 0.3 = molto basso (capital preservation)
RISK_PER_TRADE_PERCENT=0.3
RISK_PER_TRADE_AMOUNT=50.0

# Drawdown massimo giornaliero. Se superato il daemon si ferma fino a EOD.
MAX_DAILY_DRAWDOWN_PERCENT=1.5

# Drawdown rolling 24h (anti-recency-overtrading)
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=2.0

# Stop loss bounds in pips. Sotto 8 = troppo stretto, ucciso dal noise.
MIN_SL_PIPS=10
MAX_SL_PIPS=60

# Cap assoluto lots per trade. 0 = solo profilo. >0 = override.
MAX_LOTS_PER_TRADE=0.2


# -----------------------------------------------------------------------------
# FILTRI TECNICI — quando un setup e' READY per il TRADE
# -----------------------------------------------------------------------------
# Soglia confidence finale. <0.6 = setup borderline scartato.
# Conservativo alza la soglia per qualita' massima.
MIN_CONFIDENCE_TO_PROPOSE=0.65

# Volatilita' minima/massima accettata (ATR in pips).
# <3 pips = mercato morto, no opportunita'
# >50 pips = whipsaw, SL saltati
MIN_ATR_PIPS=4
MAX_ATR_PIPS=40

# Forza minima trend (0-1, basata su slope SMA + allineamento MAs).
# 0.65 = trend chiaro e direzionale
MIN_TREND_STRENGTH=0.70

# Volume breakout: rapporto volume candela vs media. >1.3 = volume confermato.
MIN_BREAKOUT_VOLUME_RATIO=1.4

# Risk/Reward minimo richiesto al setup (tp_distance / sl_distance)
MIN_RISK_REWARD_RATIO=2.0

# RSI bounds — fuori da questi range il setup e' scartato (estremo)
MAX_RSI_OVERBOUGHT=70
MIN_RSI_OVERSOLD=30

# Pattern candle (engulfing, pinbar, etc): se true, READY richiede pattern di conferma
ENABLE_CANDLESTICK_PATTERNS=true
# Barre di conferma post-pattern (filtra fakeout)
PATTERN_CONFIRMATION_BARS=2


# -----------------------------------------------------------------------------
# SUPPORTI / RESISTENZE
# -----------------------------------------------------------------------------
# Lookback per identificare swing highs/lows
SR_LOOKBACK_BARS=120
# Tolleranza per considerare prezzo "vicino" a S/R (pips).
# Bassa = setup READY solo dopo break vero, NO pre-emptive
SR_TOLERANCE_PIPS=3

# Modalita' setup READY:
# true  = richiede rottura attiva + volume sopra media (qualita' massima)
# false = ammette trend-continuation senza rottura (piu' rumore)
# Conservativo: true per filtrare fakeout
REQUIRE_BREAKOUT_FOR_READY=true


# -----------------------------------------------------------------------------
# GESTIONE POSIZIONI APERTE (fase 16)
# -----------------------------------------------------------------------------
# Soglia profitto (in multipli del rischio iniziale R) sotto la quale
# il daemon NON chiude proattivamente, anche se contesto diventa negativo.
# 1.0R = chiudi solo se gia' a +1R (proteggi profit, evita whipsaw exit)
MIN_PROTECT_PROFIT_R_MULTIPLIER=1.5

# Follow-up sui setup FORMING (attendere conferma breakout)
FOLLOWUP_ENABLED=true


# -----------------------------------------------------------------------------
# NEWS SENTIMENT (fase 15)
# -----------------------------------------------------------------------------
# Blocca trade durante finestre di news ad alto impatto
AVOID_MAJOR_NEWS_TIMES=true
ENABLE_NEWS_SENTIMENT=true
NEWS_FETCH_INTERVAL_MINUTES=15
NEWS_LOOKBACK_HOURS=2
NEWS_CACHE_MAX_HOURS=24
# Strength minima per considerare il sentiment (0-1)
SENTIMENT_MIN_STRENGTH_FILTER=0.7
# Boost confidence quando sentiment allineato al trade
SENTIMENT_BOOST_FACTOR=0.10
# Cosa fare se sentiment confligge con trade direction:
# skip = scarta trade, delay = attendi, reduce_confidence = riduci size
SENTIMENT_CONFLICT_ACTION=skip
SENTIMENT_CONFLICT_DELAY_MINUTES=60
RSS_FEEDS=https://www.forexlive.com/feed/news,https://www.fxstreet.com/rss/news


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_ROTATION=weekly
WEEKLY_LOG_BACKUP_COUNT=8


# -----------------------------------------------------------------------------
# MODALITA' STRATEGIA
# -----------------------------------------------------------------------------
# intraday = solo daemon Python pure-strategy
# agent    = solo MCP Claude Desktop
STRATEGY_MODE=intraday
