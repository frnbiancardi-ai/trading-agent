# =============================================================================
# PROFILO MODERATO — Bilanciato qualita'/frequenza
# =============================================================================
# Filosofia: 3-5 trade/giorno, drawdown contenuto, R/R medio.
# Adatto a:
#   - Account demo o reale validato
#   - Capitale 5-25k USD
#   - Mercati normali (sessioni Londra/NY)
# Aspettative: 3-5 TRADE/giorno, mix OK / WAIT_FOLLOW_UP / NO_TRADE
# =============================================================================


# -----------------------------------------------------------------------------
# MT5 BROKER (obbligatorio)
# -----------------------------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=TenTrade-Demo


# -----------------------------------------------------------------------------
# EXECUTION MODE
# -----------------------------------------------------------------------------
# shadow = simulazione senza ordini reali
# paper  = ordini su account demo
# live   = ordini su account reale
EXECUTION_MODE=shadow
DRY_RUN=false
PAUSE_TRADING=false


# -----------------------------------------------------------------------------
# UNIVERSE
# -----------------------------------------------------------------------------
# Maggiori + cross liquidi. Spread accettabile.
INTRADAY_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,GBPJPY

# Top-N: deep-analyze i 4 piu' promettenti del light-scan
INTRADAY_SCAN_TOP_N=4

INTRADAY_TIMEFRAME=M15
INTRADAY_LOOKBACK_BARS=200


# -----------------------------------------------------------------------------
# FINESTRA OPERATIVA
# -----------------------------------------------------------------------------
OPERATING_TIMEZONE=Europe/Rome
OPERATING_WEEKDAYS=0,1,2,3,4
# Sessione estesa: pre-Londra (Asia tail) + Londra + NY
INTRADAY_START_HOUR=8
INTRADAY_END_HOUR=20

# Scan ogni 10 minuti = +50% segnali rispetto al conservative
INTRADAY_SCAN_INTERVAL_MINUTES=10
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=3

CLOSE_BEFORE_END_OF_WINDOW=true


# -----------------------------------------------------------------------------
# RISK ENGINE
# -----------------------------------------------------------------------------
# MODERATE = max_lots 0.5, max_drawdown 2.5%
RISK_MODE=MODERATE
RISK_AMOUNT_MODE=PERCENT

# 0.5% balance per trade = standard intraday equilibrato
RISK_PER_TRADE_PERCENT=0.5
RISK_PER_TRADE_AMOUNT=100.0

MAX_DAILY_DRAWDOWN_PERCENT=2.5
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=3.5

# SL bounds standard FX intraday
MIN_SL_PIPS=8
MAX_SL_PIPS=70

# Cap lots — usa profilo broker (0 = no override)
MAX_LOTS_PER_TRADE=0.4


# -----------------------------------------------------------------------------
# FILTRI TECNICI — Bilanciati
# -----------------------------------------------------------------------------
# 0.50 = soglia bilanciata. Lascia passare setup decenti, scarta i deboli
MIN_CONFIDENCE_TO_PROPOSE=0.50

# Volatilita' range standard FX maggiori
MIN_ATR_PIPS=3
MAX_ATR_PIPS=55

# Trend direzionale ma non estremo
MIN_TREND_STRENGTH=0.50

# Volume breakout standard
MIN_BREAKOUT_VOLUME_RATIO=1.2

# R/R minimo 1.5 = standard professionale intraday
MIN_RISK_REWARD_RATIO=1.5

# RSI band ampia (consente swing trades non solo estremi)
MAX_RSI_OVERBOUGHT=75
MIN_RSI_OVERSOLD=25

# Pattern candle: utile come filtro qualita', non blocca volume
ENABLE_CANDLESTICK_PATTERNS=true
PATTERN_CONFIRMATION_BARS=1


# -----------------------------------------------------------------------------
# SUPPORTI / RESISTENZE
# -----------------------------------------------------------------------------
SR_LOOKBACK_BARS=100
# Tolleranza media: setup READY anche prima del break definitivo (anticipo)
SR_TOLERANCE_PIPS=8

# Modalita' setup READY:
# true  = richiede rottura attiva max swing + volume (qualita' alta)
# false = ammette anche trend-continuation senza rottura (piu' segnali)
# Moderato: true per mantenere qualita', se troppo pochi TRADE -> false
REQUIRE_BREAKOUT_FOR_READY=true


# -----------------------------------------------------------------------------
# GESTIONE POSIZIONI APERTE
# -----------------------------------------------------------------------------
# 1.0R = chiudi proattivamente se gia' a breakeven+R e contesto cambia
MIN_PROTECT_PROFIT_R_MULTIPLIER=1.0
FOLLOWUP_ENABLED=true


# -----------------------------------------------------------------------------
# NEWS SENTIMENT
# -----------------------------------------------------------------------------
AVOID_MAJOR_NEWS_TIMES=true
ENABLE_NEWS_SENTIMENT=true
NEWS_FETCH_INTERVAL_MINUTES=15
NEWS_LOOKBACK_HOURS=2
NEWS_CACHE_MAX_HOURS=24
SENTIMENT_MIN_STRENGTH_FILTER=0.6
SENTIMENT_BOOST_FACTOR=0.15
# delay = attendi se sentiment contrario, riprova dopo SENTIMENT_CONFLICT_DELAY_MINUTES
SENTIMENT_CONFLICT_ACTION=delay
SENTIMENT_CONFLICT_DELAY_MINUTES=45
RSS_FEEDS=https://www.forexlive.com/feed/news,https://www.fxstreet.com/rss/news


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_ROTATION=weekly
WEEKLY_LOG_BACKUP_COUNT=8


# -----------------------------------------------------------------------------
# STRATEGIA
# -----------------------------------------------------------------------------
STRATEGY_MODE=intraday
