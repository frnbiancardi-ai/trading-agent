# ──────────────────────────────────────────────
# Profilo: AGGRESSIVE
# Obiettivo: massima copertura opportunità. Accetta setup C.
# Solo per conti demo o capitale a rischio dichiarato.
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# MT5 — credenziali conto demo (broker: TenTrade)
# ──────────────────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=TenTrade-Demo

# ──────────────────────────────────────────────
# Risk — profilo AGGRESSIVE
# ──────────────────────────────────────────────
RISK_MODE=AGGRESSIVE
RISK_PER_TRADE_PERCENT=1.5
MAX_DAILY_DRAWDOWN_PERCENT=4.0
MIN_SL_PIPS=8
MAX_SL_PIPS=120
RISK_AMOUNT_MODE=PERCENT
RISK_PER_TRADE_AMOUNT=200.0
# 0 = default profilo (AGGRESSIVE = 1.0 lots)
MAX_LOTS_PER_TRADE=0

# ──────────────────────────────────────────────
# Symbols / Sessione
# ──────────────────────────────────────────────
SYMBOLS=EURUSD
SESSION_START=07:00
SESSION_END=22:00
USE_SESSION_FILTER=true

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ──────────────────────────────────────────────
# Claude API
# ──────────────────────────────────────────────
CLAUDE_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.6

# ──────────────────────────────────────────────
# Analisi
# ──────────────────────────────────────────────
TIMEFRAME=M15

# ──────────────────────────────────────────────
# Execution — shadow obbligatorio finché non validato
# ──────────────────────────────────────────────
EXECUTION_MODE=shadow

# ──────────────────────────────────────────────
# Scheduler / Daily orchestrator
# ──────────────────────────────────────────────
OPERATING_TIMEZONE=Europe/Rome
OPERATING_START_HOUR=7
OPERATING_END_HOUR=23
OPERATING_WEEKDAYS=0,1,2,3,4
MAIN_CYCLE_HOURS=2
DAILY_TARGET_DECISIONS=8
MAX_DELAY_MINUTES=120
MAX_SYMBOLS_TO_DEEPEN=4
FOLLOWUP_ENABLED=true
SCHEDULER_POLL_SECONDS=5
INTRADAY_CYCLE_MINUTES=5

# ──────────────────────────────────────────────
# Scheduler H24
# ──────────────────────────────────────────────
INTRADAY_SCAN_INTERVAL_MINUTES=10
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=2
PAUSE_TRADING=false
DRY_RUN=false
MIN_PROTECT_PROFIT_R_MULTIPLIER=0.8
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=5.0
LOG_ROTATION=weekly
WEEKLY_LOG_BACKUP_COUNT=8
CLOSE_BEFORE_END_OF_WINDOW=true

# ──────────────────────────────────────────────
# Strategia Intraday
# ──────────────────────────────────────────────
STRATEGY_MODE=intraday
INTRADAY_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD,AUDUSD,USDCAD,EURJPY
INTRADAY_TIMEFRAME=M15
INTRADAY_LOOKBACK_BARS=200
INTRADAY_SCAN_TOP_N=4
INTRADAY_START_HOUR=7
INTRADAY_END_HOUR=22
AVOID_MAJOR_NEWS_TIMES=false

# Parametri tecnici — soglie larghe
MIN_ATR_PIPS=2
MAX_ATR_PIPS=80
MIN_TREND_STRENGTH=0.55
MIN_BREAKOUT_VOLUME_RATIO=1.1
MIN_RISK_REWARD_RATIO=1.3
MAX_RSI_OVERBOUGHT=80
MIN_RSI_OVERSOLD=20
MIN_CONFIDENCE_TO_PROPOSE=0.40
# Spread baseline per il fattore spread_session della confluence (audit 2026-05-28 CRIT-2)
SPREAD_BASELINE_PIPS=1.0

# Pattern recognition
ENABLE_CANDLESTICK_PATTERNS=true
PATTERN_CONFIRMATION_BARS=1

# Support / Resistance
SR_LOOKBACK_BARS=80
SR_TOLERANCE_PIPS=7

# ──────────────────────────────────────────────
# RSS News Sentiment — gating leggero
# ──────────────────────────────────────────────
ENABLE_NEWS_SENTIMENT=true
NEWS_FETCH_INTERVAL_MINUTES=10
NEWS_LOOKBACK_HOURS=1
NEWS_CACHE_MAX_HOURS=12
SENTIMENT_MIN_STRENGTH_FILTER=0.5
SENTIMENT_BOOST_FACTOR=0.20
SENTIMENT_CONFLICT_ACTION=reduce_confidence
SENTIMENT_CONFLICT_DELAY_MINUTES=30
RSS_FEEDS=https://www.investing.com/rss/news_25.rss,https://www.forexlive.com/feed/news
