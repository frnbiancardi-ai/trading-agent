# =============================================================================
# PROFILO AGGRESSIVO — Massima frequenza, alta tolleranza al rischio
# =============================================================================
# Filosofia: tanti segnali, accetta drawdown maggiore, scalping/momentum.
# Adatto a:
#   - Test e debugging del daemon (verifica che TRADE escano)
#   - Trader esperti con capitale dedicato (>25k USD)
#   - Mercati trending forti (post-news, breakout sessione)
# AVVERTENZA: usare SOLO con EXECUTION_MODE=shadow o paper finche' non validato
# Aspettative: 8-15 TRADE/giorno, alta varianza P&L
# =============================================================================


# -----------------------------------------------------------------------------
# MT5 BROKER (obbligatorio)
# -----------------------------------------------------------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=changeme
MT5_SERVER=TenTrade-Demo


# -----------------------------------------------------------------------------
# EXECUTION MODE
# -----------------------------------------------------------------------------
# CONSIGLIO FORTE: lascia shadow per profilo aggressivo finche' non hai
# almeno 2 settimane di metriche validate
EXECUTION_MODE=shadow
DRY_RUN=false
PAUSE_TRADING=false


# -----------------------------------------------------------------------------
# UNIVERSE — ampio per massimizzare opportunita'
# -----------------------------------------------------------------------------
# Maggiori + cross + qualche commodity-linked. Piu' rumore, piu' segnali.
INTRADAY_SYMBOLS=EURUSD,GBPUSD,USDJPY,AUDUSD,USDCAD,NZDUSD,GBPJPY,EURJPY,EURGBP,AUDJPY

# Top-N alto = analizza tutti i candidati senza filtraggio aggressivo
INTRADAY_SCAN_TOP_N=10

INTRADAY_TIMEFRAME=M15
INTRADAY_LOOKBACK_BARS=200


# -----------------------------------------------------------------------------
# FINESTRA OPERATIVA — H24 reale
# -----------------------------------------------------------------------------
OPERATING_TIMEZONE=Europe/Rome
OPERATING_WEEKDAYS=0,1,2,3,4
# Inizio prima dell'apertura Londra, chiusura dopo close NY
INTRADAY_START_HOUR=7
INTRADAY_END_HOUR=22

# Scan ogni 5 min = 12 cicli/ora, massima reattivita'
INTRADAY_SCAN_INTERVAL_MINUTES=5
INTRADAY_FIRST_CYCLE_DELAY_MINUTES=1

# Disabilita chiusura forzata fine giornata (porta posizioni overnight)
# WARN: aumenta esposizione a gap weekend/news notturne
CLOSE_BEFORE_END_OF_WINDOW=false


# -----------------------------------------------------------------------------
# RISK ENGINE — tollerante
# -----------------------------------------------------------------------------
# AGGRESSIVE = max_lots 1.0, max_drawdown 4.0%
RISK_MODE=AGGRESSIVE
RISK_AMOUNT_MODE=PERCENT

# 1% per trade = oltre la guideline standard (0.5%), accetta varianza
RISK_PER_TRADE_PERCENT=1.0
RISK_PER_TRADE_AMOUNT=200.0

MAX_DAILY_DRAWDOWN_PERCENT=4.0
ROLLING_DRAWDOWN_WINDOW_HOURS=24
ROLLING_DRAWDOWN_MAX_PERCENT=6.0

# SL bounds estesi per coprire whipsaw
MIN_SL_PIPS=6
MAX_SL_PIPS=100

# Cap lots = max profilo broker
MAX_LOTS_PER_TRADE=0


# -----------------------------------------------------------------------------
# FILTRI TECNICI — RILASSATI per generare segnali
# -----------------------------------------------------------------------------
# 0.30 = soglia bassa, accetta setup borderline (test mode)
MIN_CONFIDENCE_TO_PROPOSE=0.30

# Range volatilita' molto largo
MIN_ATR_PIPS=2
MAX_ATR_PIPS=100

# Trend debole accettato (anche range trading)
MIN_TREND_STRENGTH=0.30

# Volume breakout = nessun filtro praticamente
MIN_BREAKOUT_VOLUME_RATIO=1.0

# R/R minimo abbassato (accetta scalp 1:1)
MIN_RISK_REWARD_RATIO=1.0

# RSI band massima (entra anche su estremi - mean reversion)
MAX_RSI_OVERBOUGHT=80
MIN_RSI_OVERSOLD=20

# Pattern candele DISABILITATI = non blocca breakout puri
ENABLE_CANDLESTICK_PATTERNS=false
PATTERN_CONFIRMATION_BARS=1


# -----------------------------------------------------------------------------
# SUPPORTI / RESISTENZE
# -----------------------------------------------------------------------------
SR_LOOKBACK_BARS=80
# Tolleranza ALTA = READY anche lontano dal break, anticipa movimenti
# Combinato con la patch in identify_entry_setup, genera molti READY pre-emptive
SR_TOLERANCE_PIPS=20

# Modalita' setup READY:
# true  = richiede rottura attiva max swing high/low + volume sopra media (raro)
# false = READY anche su trend-continuation/pullback senza rottura (molti piu' segnali)
# Aggressivo: false per generare TRADE in mercati senza breakout pulito
REQUIRE_BREAKOUT_FOR_READY=false


# -----------------------------------------------------------------------------
# GESTIONE POSIZIONI APERTE
# -----------------------------------------------------------------------------
# 0.5R = chiudi prima per limitare downside (no buy-and-hope)
MIN_PROTECT_PROFIT_R_MULTIPLIER=0.5
FOLLOWUP_ENABLED=true


# -----------------------------------------------------------------------------
# NEWS SENTIMENT
# -----------------------------------------------------------------------------
# Aggressivo: NON evitare le news (cavalca le mosse)
AVOID_MAJOR_NEWS_TIMES=false
ENABLE_NEWS_SENTIMENT=true
NEWS_FETCH_INTERVAL_MINUTES=10
NEWS_LOOKBACK_HOURS=1
NEWS_CACHE_MAX_HOURS=12
# Strength bassa = sentiment usato anche se debole
SENTIMENT_MIN_STRENGTH_FILTER=0.4
# Boost alto = confidence ricalibrata aggressivamente su sentiment
SENTIMENT_BOOST_FACTOR=0.25
# reduce_confidence = NON skippare il trade, riduci size
SENTIMENT_CONFLICT_ACTION=reduce_confidence
SENTIMENT_CONFLICT_DELAY_MINUTES=15
RSS_FEEDS=https://www.forexlive.com/feed/news,https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news.rss


# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# DEBUG = utile in profilo aggressivo per capire perche' setup escono
LOG_LEVEL=DEBUG
LOG_FILE=logs/agent.log
LOG_ROTATION=daily
WEEKLY_LOG_BACKUP_COUNT=14


# -----------------------------------------------------------------------------
# STRATEGIA
# -----------------------------------------------------------------------------
STRATEGY_MODE=intraday
